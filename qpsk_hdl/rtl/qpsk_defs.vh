// ------------------------------------------------------------------------
// qpsk_defs.vh - generated by model/qpsk_fxparams.py.  Do not edit.
// Every constant here is also used by the Python golden model, so the
// RTL and the model cannot disagree.
//
// This file is included inside each module body and declares only
// localparams, which are module scoped.  It therefore carries no
// include guard: a guard would let the first include win and leave
// every later module without the constants.
// ------------------------------------------------------------------------

// ---- sample format -------------------------------------------------
localparam integer W        = 16;   // sample word, s(16,15)
localparam integer FRAC     = 15;
localparam integer AW       = 16;   // angle word, one turn = 2**16

// ---- packet structure ----------------------------------------------
localparam integer SPS           = 4;
localparam integer PREAMBLE_SYMS = 13;
localparam integer DATA_BITS     = 512;
localparam integer DATA_SYMS     = 256;
localparam integer PKT_SYMS      = 269;
localparam [12:0] BARKER = 13'b1010110011111;  // b[0] is the first symbol
localparam signed [W-1:0] QPSK_A = 23170;   // 1/sqrt(2)

// ---- scrambler ------------------------------------------------------
localparam [6:0] SCRAM_SEED = 7'h7f;

// ---- transmit RRC, polyphase by 4 ----------------------------------
localparam integer TX_NTAP_P = 11;
localparam [175:0] TX_H0 = 176'hffedfed9005804d6f3e87ffff3e804d60058fed9ffed;
localparam [175:0] TX_H1 = 176'h0000ff9101e001c3ee206f1011e001c3fe20ff9100ac;
localparam [175:0] TX_H2 = 176'h000000920139fe4af77341f241f2f773fe4a01390092;
localparam [175:0] TX_H3 = 176'h000000acff91fe2001c311e06f10ee2001c301e0ff91;

// ---- receive RRC matched filter, 41 symmetric taps ------------------
localparam integer RX_NTAPS = 41;
localparam integer RX_NHALF = 21;
localparam [335:0] RX_H = 336'h24601f2f12840505fc9bfafbfd99007f015c007fff85ff79001900870058ffe1ffadffe100290030fffb;

// ---- CORDIC ---------------------------------------------------------
localparam integer CORDIC_W     = 20;
localparam integer CORDIC_F     = 17;
localparam integer CORDIC_NITER = 16;
localparam signed [15:0] CORDIC_KINV = 19898;
localparam [255:0] CORDIC_ATAN = 256'h00000001000100030005000a00140029005100a30146028b051109fb12e42000;

// ---- AGC ------------------------------------------------------------
localparam integer AGC_GW         = 20;
localparam integer AGC_GFRAC      = 12;
localparam integer AGC_G_INIT     = 4096;
localparam integer AGC_G_MIN      = 1024;
localparam integer AGC_G_MAX      = 262144;
localparam integer AGC_PW         = 26;
localparam integer AGC_PFRAC      = 22;
localparam integer AGC_P_ALIGN    = 8;
localparam integer AGC_TARGET     = 524288;
localparam integer AGC_AVG_SHIFT  = 6;
localparam integer AGC_STEP_SHIFT = 6;

// ---- symbol timing recovery -----------------------------------------
localparam integer STR_CW        = 16;
localparam integer STR_W_NOM     = 32768;
localparam integer STR_MU_SH     = 1;
localparam integer STR_K6        = 5461;
localparam integer STR_E_SH      = 14;
localparam integer STR_KP_S      = 18;
localparam integer STR_KP_M      = 16644;
localparam integer STR_KI_S      = 14;
localparam integer STR_KI_M      = 17043;
localparam integer STR_INTEG_F   = 12;
localparam integer STR_VCTL_LIM  = 8192;

// ---- coarse frequency recovery --------------------------------------
localparam integer CF_BLK        = 256;
localparam integer CF_BLK_W      = 8;
localparam integer CF_ACC_W      = 25;
localparam integer CF_ACC_SH     = 7;
localparam integer VEC_IN_W      = 18;
localparam integer CF_PH_F       = 8;
localparam integer CF_PH_W       = 24;
localparam integer CF_GUARD      = 4;
localparam integer CF_FAST_BLK   = 4;
localparam integer CF_SLOW_SHIFT = 3;

// ---- fine frequency recovery ----------------------------------------
localparam integer FF_PH_F    = 8;
